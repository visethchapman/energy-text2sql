# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://energy:energy_dev@localhost:5432/energy

# EIA Open Data API key (free, instant signup at https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# Anthropic key (not needed for Day 1 — required Day 2 once the agent goes online)
ANTHROPIC_API_KEY=

# LangSmith tracing (optional). When enabled, every LangGraph run is traced to
# smith.langchain.com — nodes, tokens, latency, cost. Free tier; sign up at
# https://smith.langchain.com. Leave TRACING=false to disable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=energy-text2sql
